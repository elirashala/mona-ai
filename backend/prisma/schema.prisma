generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model ImportBatch {
  id             String      @id @default(uuid()) @db.Uuid
  filename       String
  encoding       String
  createdAt      DateTime    @default(now())
  totalRows      Int
  importedCount  Int
  invalidCount   Int
  duplicateCount Int
  rows           ImportRow[]
}

model ImportRow {
  id        Int         @id @default(autoincrement())
  importId  String      @db.Uuid
  batch     ImportBatch @relation(fields: [importId], references: [id])
  rowNumber Int
  status    String
  requestId String?
  original  Json
  errors    Json

  @@unique([importId, rowNumber])
}

model Request {
  requestId   String   @id
  site        String
  reportedOn  DateTime @db.Date
  category    String
  description String
  amountChf   Decimal  @db.Decimal
  technician  String
  original    Json
  createdAt   DateTime @default(now())

  @@index([reportedOn])
}
